# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
build/
DerivedData/

# Snapshot test failure artifacts (freshly-rendered mismatches, written per failing run)
AuraTests/__SnapshotFailures__/

# Swift Package Manager
.build/
# .swiftpm is per-user state, except shared schemes (committed — Xcode Cloud needs them)
**/.swiftpm/*
!**/.swiftpm/xcode
**/.swiftpm/xcode/*
!**/.swiftpm/xcode/xcshareddata

# Claude (personal local settings)
.claude/settings.local.json

# Python bytecode cache
__pycache__/
